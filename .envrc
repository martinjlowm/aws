#!/usr/bin/env bash

eval "$(devenv direnvrc)"

use devenv

# music/nix/default.nix reads this to resolve the storage account's bucket, and
# `granted` has to have been run first. Empty until then, which is why the music
# output fails to evaluate rather than deploying to the wrong account.
#
# The load reads AWS Organizations and exits non-zero, saying why on stderr, when
# it has no session to read it with. Keep AWS_ORG empty in that case instead of
# taking the exit status as a value: the rest of the shell has nothing to do with
# the organization and works without it.
if aws_org=$(bun organization/scripts/load.ts); then
  export AWS_ORG=$aws_org
else
  export AWS_ORG=
  log_status "AWS_ORG is empty, so the music output will not evaluate. Reload direnv once a session is assumed."
fi
unset aws_org
